{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hyvemind project config",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "cli": {
      "type": "string",
      "description": "Command the installed skills use to run hyvemind. Default: npx -y hyvemind@<installed version>"
    },
    "preset": {
      "enum": [
        "generic",
        "node",
        "python",
        "openwop"
      ]
    },
    "skills": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[a-z0-9-]*$"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "include": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defer": {
          "type": "object",
          "description": "Bundled skill name -> project skill name. The bundled skill is still installed, with a header saying to follow the project skill instead wherever it applies.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[\\w.:/-]+$"
          }
        }
      }
    },
    "agentsMd": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "run"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "pattern": "\\{test\\}"
        },
        "lanes": {
          "type": "object",
          "required": [
            "default"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutSec": {
          "type": "number"
        },
        "errorPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "enum": [
            "output",
            "vitest",
            "node"
          ],
          "default": "output",
          "description": "How to read case-level results; needed for a probe's expectRed"
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "bannedPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "nextNumberCommand": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evals": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSec": {
          "type": "number"
        },
        "liftThreshold": {
          "type": "number"
        },
        "minRuns": {
          "type": "integer",
          "minimum": 1
        },
        "scenariosDir": {
          "type": "string"
        },
        "includeBundled": {
          "type": "boolean",
          "default": true,
          "description": "Also run the scenarios bundled with each hyvemind skill"
        }
      }
    },
    "train": {
      "type": "object",
      "description": "Merge queue (hyvemind train)",
      "properties": {
        "base": {
          "type": "string",
          "default": "main"
        },
        "dir": {
          "type": "string",
          "description": "Persistent train worktree; default ../<repo>-hyve-train"
        },
        "setup": {
          "type": "string",
          "description": "Run in the train worktree before each gate, e.g. \"npm ci\""
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "via": {
          "enum": [
            "hyvemind",
            "external"
          ],
          "default": "hyvemind",
          "description": "\"external\": the project merges through its own path; hyvemind train refuses to merge"
        },
        "message": {
          "type": "string",
          "description": "Where merges go when train.via is \"external\", e.g. \"merges go through the release queue\""
        }
      }
    },
    "run": {
      "type": "object",
      "description": "Plan runner (hyvemind run)",
      "properties": {
        "agent": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Implementer argv with {prompt}; default claude -p --permission-mode acceptEdits {prompt}"
        },
        "reviewer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "timeoutSec": {
          "type": "number",
          "default": 1800
        }
      }
    },
    "affected": {
      "type": "object",
      "description": "Test-impact selection (hyvemind affected)",
      "properties": {
        "testPattern": {
          "type": "string"
        },
        "fullRunOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "command": {
          "type": "string",
          "description": "Run selected tests; {tests} is replaced"
        },
        "allCommand": {
          "type": "string"
        },
        "observeCommand": {
          "type": "string",
          "description": "Full run with a Vitest JSON report at {report}, for --observe"
        },
        "trust": {
          "type": "object",
          "properties": {
            "minObservations": {
              "type": "integer",
              "default": 20
            },
            "minDays": {
              "type": "number",
              "default": 7
            }
          }
        }
      }
    },
    "externalGate": {
      "type": "object",
      "required": [
        "run",
        "done"
      ],
      "description": "The project already has its own gate. hyvemind points agents at it and claims no second definition of done. Mutually exclusive with gates.",
      "properties": {
        "run": {
          "type": "string",
          "description": "The project's gate command, e.g. node scripts/local-ci.mjs --pr <n> --post"
        },
        "done": {
          "type": "string",
          "description": "What counts as done, e.g. the `ci/local-verify` status is success on the PR head"
        }
      }
    },
    "broker": {
      "type": "object",
      "description": "Optional machine-wide CI broker (tracegate-ci). When set, gates, train gates, probes and eval agent runs are wrapped in `<command> lease` so they wait for capacity.",
      "properties": {
        "command": {
          "type": "string",
          "default": "tracegate"
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Where hyvemind evidence gets its proof",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Commit-status context posted by the project's own gate (e.g. the one externalGate.done names). When set, a success status of this context on a clean HEAD is the proof, and evidence --post posts no hyvemind/gate."
        }
      }
    }
  }
}
